# Copie este archivo como rag/.env y complete las claves. rag/.env no se sube al repositorio.
# Una variable definida en la sesión de PowerShell tiene prioridad sobre este archivo.

# Comparación de LLM (rag/evaluacion/modelos_llm.json). Ollama no necesita clave.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
BEDROCK_API_KEY=

# Opcional: embeddings y umbrales calibrados con BGE-M3.
# RAG_EMBEDDINGS=BAAI/bge-m3
# RAG_UMBRAL_SIMILITUD=0.40
# RAG_UMBRAL_FUERTE=0.70
